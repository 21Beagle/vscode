{
    "javascript.updateImportsOnFileMove.enabled": "always",
    "terminal.integrated.tabs.enabled": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "highlight.configuration.ignoreCase": false,
    "editor.inlineSuggest.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "git.autofetch": true,

    "editor.fontFamily": "'Agave Nerd Font Regular', 'Consolas', 'Courier New', monospace",
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "prettier.tabWidth": 4,
    "files.maxMemoryForLargeFilesMB": 16000,
    "cSpell.userWords": ["Consts", "ENPASSANT", "MOUSEBUTTONUP", "Perma", "rnbqkbnr"],
    "prettier.printWidth": 160,
    "editor.stickyTabStops": true,
    "editor.stickyScroll.enabled": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.formatOnType": true,
    },
    "cSpell.diagnosticLevel": "Hint",
    "redhat.telemetry.enabled": true,
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml",
    },
    // "terminal.integrated.defaultProfile.windows": "Git Bash",
    "errorLens.delay": 1000,
    "workbench.colorTheme": "Bearded Theme Arc",
    "csharp.debug.console": "externalTerminal",
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
    },
    // "terminal.integrated.automationProfile.linux": {}
    // Ignore files that cannot be read as EuroAbsFileInfo
    "vim.leader": "<space>",
    "vim.timeout": 500,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.ignorecase": true,
    "vim.smartcase": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.handleKeys": {
        "<C-a>": true,
        "<C-h>": true,
        "<C-j>": true,
        "<C-k>": true,
        "<C-l>": true,
        "<C-p>": true,
        "<C-s>": true,
        "<C-t>": true,
        "<C-y>": true,
        "<C-z>": true,
    },
    "vim.insertModeKeyBindingsNonRecursive": [
        {
            "before": ["j", "j"],
            "after": ["<Esc>"],
            "silent": true,
        },
        {
            "before": ["j", "k"],
            "after": ["<Esc>"],
            "silent": true,
        },
        {
            "before": ["<C-h>"],
